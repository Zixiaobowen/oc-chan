{"schema":1,"manifest":{"id":"system","version":"1.0.0","apiVersion":1,"name":"系统监控","nameEn":"System Monitor","description":"采集本机 CPU、内存、磁盘、默认网络接口速率与进程排名。插件停用或卸载时取消采集并释放资源。","descriptionEn":"Collect local CPU, memory, disk, default network interface rates and process rankings. Disabling or uninstalling cancels collection and releases resources.","publisher":"OC Chan","section":"system","minAppVersion":"0.1.0","platforms":["darwin"],"permissions":["system-metrics","process-ranking","read-default-network-interface"]},"code":"Object.defineProperty(exports, Symbol.toStringTag, { value: \"Module\" });\n// \\0rolldown/runtime.js\nvar __create = Object.create;\nvar __defProp = Object.defineProperty;\nvar __getOwnPropDesc = Object.getOwnPropertyDescriptor;\nvar __getOwnPropNames = Object.getOwnPropertyNames;\nvar __getProtoOf = Object.getPrototypeOf;\nvar __hasOwnProp = Object.prototype.hasOwnProperty;\nvar __copyProps = (to, from, except, desc) => {\n\tif (from && typeof from === \"object\" || typeof from === \"function\") for (var keys = __getOwnPropNames(from), i = 0, n = keys.length, key; i < n; i++) {\n\t\tkey = keys[i];\n\t\tif (!__hasOwnProp.call(to, key) && key !== except) __defProp(to, key, {\n\t\t\tget: ((k) => from[k]).bind(null, key),\n\t\t\tenumerable: !(desc = __getOwnPropDesc(from, key)) || desc.enumerable\n\t\t});\n\t}\n\treturn to;\n};\nvar __toESM = (mod, isNodeMode, target) => (target = mod != null ? __create(__getProtoOf(mod)) : {}, __copyProps(isNodeMode || !mod || !mod.__esModule || !__hasOwnProp.call(mod, \"default\") ? __defProp(target, \"default\", {\n\tvalue: mod,\n\tenumerable: true\n}) : target, mod));\nlet node_os = require(\"node:os\");\nnode_os = __toESM(node_os);\nlet node_fs_promises = require(\"node:fs/promises\");\n// src/plugins/system-monitor/main/network.ts\nvar MAX_OUTPUT_BYTES = 65536;\nfunction parseDefaultInterface(output) {\n\tif (Buffer.byteLength(output) > MAX_OUTPUT_BYTES) throw new Error(\"默认路由输出超过限制\");\n\tconst matches = [...output.matchAll(/^\\s*interface:\\s*(\\S+)\\s*$/gm)];\n\tif (matches.length !== 1 || !/^[a-z][a-z0-9._:-]{0,31}$/.test(matches[0][1])) throw new Error(\"没有可用的默认网络接口\");\n\treturn matches[0][1];\n}\nfunction parseNetworkCounters(output, iface) {\n\tif (Buffer.byteLength(output) > MAX_OUTPUT_BYTES) throw new Error(\"网络统计输出超过限制\");\n\tconst lines = output.trim().split(\"\\n\");\n\tconst headers = lines[0].trim().split(/\\s+/);\n\tconst rxIndex = headers.indexOf(\"Ibytes\"), txIndex = headers.indexOf(\"Obytes\");\n\tif (headers[0] !== \"Name\" || headers[2] !== \"Network\" || rxIndex < 3 || txIndex <= rxIndex) throw new Error(\"网络统计表结构无法识别\");\n\tlet counters;\n\tfor (const line of lines.slice(1)) {\n\t\tconst fields = line.trim().split(/\\s+/);\n\t\tif (fields[0] !== iface && fields[0] !== `${iface}*` || !/^<Link#\\d+>$/.test(fields[2] ?? \"\")) continue;\n\t\tif (counters || fields.length < headers.length - 1 || fields.length > headers.length) throw new Error(\"网络接口统计行不完整或重复\");\n\t\tconst rx = fields[fields.length - headers.length + rxIndex], tx = fields[fields.length - headers.length + txIndex];\n\t\tif (!/^\\d+$/.test(rx) || !/^\\d+$/.test(tx)) throw new Error(\"网络接口计数器无效\");\n\t\tconst received = Number(rx), sent = Number(tx);\n\t\tif (!Number.isSafeInteger(received) || !Number.isSafeInteger(sent)) throw new Error(\"网络接口计数器超过安全范围\");\n\t\tcounters = {\n\t\t\treceived,\n\t\t\tsent\n\t\t};\n\t}\n\tif (!counters) throw new Error(\"网络接口未返回链路计数器\");\n\treturn counters;\n}\nvar NetworkReader = class {\n\tsdk;\n\tnow;\n\tprevious;\n\tcontroller = new AbortController();\n\trun;\n\tconstructor(sdk, run, now = () => performance.now()) {\n\t\tthis.sdk = sdk;\n\t\tthis.now = now;\n\t\tthis.run = run ?? (async (file, args, signal) => (await sdk.runBudgetedCommand(\"system-network\", file, args, {\n\t\t\ttimeout: 4e3,\n\t\t\tmaxBuffer: MAX_OUTPUT_BYTES,\n\t\t\tenv: {\n\t\t\t\t...process.env,\n\t\t\t\tLC_ALL: \"C\"\n\t\t\t}\n\t\t}, signal)).stdout);\n\t}\n\tdispose() {\n\t\tthi