{
  "name": "oc-chan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本机 Agent、定时任务与系统运行监控",
  "author": "bowen.sun",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/develop.mjs",
    "dev:window": "node scripts/develop.mjs --window",
    "typecheck": "tsc --noEmit",
    "build:frontend": "vite build",
    "build:app": "node scripts/build-app.mjs",
    "build": "npm run typecheck && npm run build:app",
    "test": "node scripts/ci-tests.mjs",
    "test:ci": "node scripts/ci-tests.mjs",
    "smoke:renderer": "node scripts/smoke-renderer.mjs",
    "package": "npm run build:app && node scripts/dist.mjs --dir",
    "dist": "npm run build:app && node scripts/dist.mjs",
    "test:release": "node --test scripts/prepare-release.test.mjs scripts/publish-release.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "delivery:local": "node scripts/local-delivery.mjs",
    "audit:dependencies": "node scripts/dependency-review.mjs",
    "install:local": "node scripts/install-local.mjs",
    "build:plugins": "cargo build --release -p oc-system-monitor && node scripts/build-plugin-market-rust.mjs --collector target/release/collector --manifest plugins/system-monitor/manifest.json --out out/plugin-market",
    "cleanup:local": "node scripts/local-app-lifecycle.mjs",
    "push:main": "node scripts/push-main.mjs",
    "closeout:task": "node scripts/closeout-task.mjs",
    "test:install": "cargo test -p oc-installer --lib -- --test-threads=1",
    "test:frontend": "tsx --test src/renderer/src/*.test.ts src/shared/*.test.ts"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "kubai-icons-react": "0.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "unzipper": "0.12.5",
    "vite": "^8.3.5"
  }
}
