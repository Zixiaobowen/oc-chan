{
  "name": "oc-chan",
  "version": "0.1.0",
  "private": true,
  "description": "本机 Agent、定时任务与系统运行监控",
  "main": "out/main/index.js",
  "author": "bowen.sun",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run typecheck && npm run build:native && electron-vite build",
    "start": "electron out/main/index.js",
    "test": "tsx --test src/main/*.test.ts src/main/collectors/*.test.ts src/renderer/src/agent-topology.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "package": "npm run build && electron-builder --mac dir --publish never"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "local.oc-chan.desktop",
    "productName": "OC Chan",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/tern-navigation", "to": "tern-navigation" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "resources/icon.icns"
    },
    "asar": true
  }
}
